<style>
  .announcement-bar {
    margin-left: auto;
    margin-right: auto;
    width: {{ section.settings.announcement_width | default: 100 }}%;
    --colorAnnouncement: {{ section.settings.announcement_background_color | default: settings.color_announcement | default: '#1c1d1d' }};
    --colorAnnouncementText: {{ section.settings.announcement_text_color | default: settings.color_announcement_text | default: '#ffffff' }};
  }

  {%- if settings.color_announcement == settings.color_body_bg -%}
    .announcement-bar {
      border-bottom: 1px solid;
    }
  {%- endif -%}
</style>

{%- render 'announcement-bar', section: section -%}

{% schema %}
{
  "name": "t:sections.header.settings.header_announcement_bar",
  "settings": [
    {
      "type": "color",
      "id": "announcement_background_color",
      "label": "Background color"
    },
    {
      "type": "color",
      "id": "announcement_text_color",
      "label": "Text color"
    },
    {
      "type": "checkbox",
      "id": "announcement_compact",
      "label": "t:sections.header.settings.announcement_compact.label"
    },
    {
      "type": "range",
      "id": "announcement_width",
      "label": "t:sections.header.settings.announcement_width.label",
      "info": "t:sections.header.settings.announcement_width.info",
      "default": 100,
      "min": 50,
      "max": 100,
      "step": 1,
      "unit": "%"
    }
  ],
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "announcement",
      "name": "t:sections.header.blocks.announcement.name",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "t:sections.header.blocks.announcement.settings.text.label",
          "default": "Hassle-free returns"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "t:sections.header.blocks.announcement.settings.link_text.label",
          "default": "30-day postage paid returns"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:sections.header.blocks.announcement.settings.link.label"
        }
      ]
    }
  ],
  "default": {
    "settings": {}
  },
  "disabled_on": {
    "groups": ["footer", "custom.popups"]
  }
}
{% endschema %}
